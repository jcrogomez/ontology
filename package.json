{
  "name": "ontology",
  "version": "0.1.0",
  "description": "Ontology semantic compiler for operational interfaces.",
  "type": "module",
  "bin": {
    "onto": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
