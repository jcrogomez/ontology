{
  "name": "ontology",
  "version": "0.3.0-alpha.0",
  "description": "Ontology semantic compiler for operational interfaces.",
  "type": "module",
  "bin": {
    "onto": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "example:hello-world": "bash examples/hello-world/build.sh"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "fast-json-stable-stringify": "^2.1.0",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "ollama": "^0.6.3",
    "react": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.28",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^4.1.5"
  }
}
