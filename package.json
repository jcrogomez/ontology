{
  "name": "@jcrogomez/ontology",
  "version": "0.4.0-rc.1",
  "description": "Version intent, not just code: a typed intention graph with a compiler (intent → code), an ingest lift (code → intent), and a full audit chain.",
  "type": "module",
  "bin": {
    "onto": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcrogomez/ontology.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "check": "tsc --noEmit",
    "check:nul": "bash scripts/check-nul-bytes.sh --all",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "example:hello-world": "bash examples/hello-world/build.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.2",
    "@google/genai": "^2.7.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^13.1.0",
    "fast-json-stable-stringify": "^2.1.0",
    "ink": "^5.2.1",
    "ink-text-input": "^6.0.0",
    "ollama": "^0.6.3",
    "react": "^18.3.1",
    "typescript": "^5.8.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.28",
    "fast-check": "^4.8.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.3",
    "vitest": "^4.1.5"
  }
}
